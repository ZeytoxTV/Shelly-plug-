# Copie ce fichier en .env puis remplis les valeurs :  cp .env.example .env
# Le fichier .env n'est JAMAIS commité (voir .gitignore).

# --- Interface web FreqUI (obligatoire) ---
# Génère des valeurs aléatoires avec :  openssl rand -hex 32
FREQTRADE__API_SERVER__PASSWORD=change_moi
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change_moi
FREQTRADE__API_SERVER__WS_TOKEN=change_moi

# --- Clés API Binance (seulement pour le trading réel, laisser vide en dry-run) ---
# Crée une clé SANS droit de retrait (withdraw désactivé) !
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- Telegram (optionnel) ---
# Mets aussi "enabled": true dans user_data/config.json section "telegram"
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
